# Required for LLM responses (get a key at https://platform.openai.com/)
OPENAI_API_KEY=

# Optional: model (defaults below)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Base URL for booking / customer actions (shown in structured replies)
BOOKING_BASE_URL=https://www.example-travel.com/book

# Human support contact (shown when escalated)
SUPPORT_CONTACT_URL=https://www.example-travel.com/support
SUPPORT_CONTACT_LABEL=Customer support

# RAG tuning
CHROMA_PATH=./chroma_db
RETRIEVAL_TOP_K=6
SIMILARITY_THRESHOLD=0.28
