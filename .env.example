# Copy to repo root as `.env` (never commit real keys)
OPENAI_API_KEY=

OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

BOOKING_BASE_URL=https://www.example-travel.com/book
SUPPORT_CONTACT_URL=https://www.example-travel.com/support
SUPPORT_CONTACT_LABEL=Customer support

CHROMA_PATH=
RETRIEVAL_TOP_K=6
SIMILARITY_THRESHOLD=0.28

# Only if OpenAI key is unset AND onnxruntime works on this machine
ALLOW_LOCAL_ONNX_EMBEDDINGS=false

# Comma-separated origins for browser clients (React dev server, production site)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
